generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  user
}

enum AccountStatus {
  active
  pending
  suspended
}

enum StreamStatus {
  scheduled
  live
  ended
}


model User {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique
  passwordHash  String        @map("password_hash")
  displayName   String        @map("display_name")
  role          UserRole
  accountStatus AccountStatus @default(active) @map("account_status")
  createdAt     DateTime      @default(now()) @map("created_at")
  ownedStreams  Stream[]

  @@map("users")
}

model Stream {
  id            String       @id @default(uuid()) @db.Uuid
  joinCode      String       @unique @map("join_code")
  title         String
  description   String       @default("")
  status        StreamStatus @default(scheduled)

  ownerId       String       @db.Uuid @map("owner_id")
  viewerCount   Int          @default(0) @map("viewer_count")
  createdAt     DateTime     @default(now()) @map("created_at")
  startedAt     DateTime?    @map("started_at")
  endedAt       DateTime?    @map("ended_at")
  owner         User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([ownerId])
  @@map("streams")
}
